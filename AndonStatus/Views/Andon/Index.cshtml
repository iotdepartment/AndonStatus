@model AndonStatus.Models.AndonRegistro

@{
    ViewData["Title"] = "Panel Andon";

    // Paleta de colores corporativa y fluida (no genérica)
    var (bgGradient, colorTexto, shadowColor, iconClass, textEstado) = Model.EstadoId switch
    {
        1 => ("linear-gradient(135deg, #ff5252, #f44336)", "#ffffff", "rgba(244, 67, 54, 0.25)", "bi-exclamation-circle", Model.Estado?.Estado1 ?? "Atención Requerida"),
        3 => ("linear-gradient(135deg, #00b09b, #96c93d)", "#ffffff", "rgba(0, 176, 155, 0.25)", "bi-check2-circle", Model.Estado?.Estado1 ?? "Línea Operativa"),
        _ => ("linear-gradient(135deg, #757f9a, #4a569d)", "#ffffff", "rgba(117, 127, 154, 0.25)", "bi-dash-circle", "Estado Desconocido")
    };
}

<!-- Iconos ligeros (lineales) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Estructura base limpia */
    .andon-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 85vh;
        padding: 30px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    /* --- CAMBIO: Contenedor integrado para el Logo --- */
    .andon-brand-badge {
        background: #ffffff;
        padding: 14px 28px;
        border-radius: 50px; /* Estilo cápsula flotante */
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03), 0 1px 2px rgba(0, 0, 0, 0.01);
        margin-bottom: 25px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .andon-brand-logo {
        max-height: 38px; /* Ajuste de tamaño proporcional */
        width: auto;
        object-fit: contain;
    }

    /* Contenedor unificado */
    .andon-main-panel {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 24px; /* Bordes muy redondeados y modernos */
        padding: 40px 35px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
        box-sizing: border-box;
        text-align: center;
    }

    /* Título sutil de ubicación (Limpieza de clases nativas de Bootstrap) */
    .andon-station-title {
        font-size: 1.8rem;
        color: #2c3e50;
        letter-spacing: -0.5px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 25px;
    }

    /* Cápsula de estado con degradado orgánico */
    .andon-status-capsule {
        background: @bgGradient;
        color: @colorTexto;
        border-radius: 20px;
        padding: 45px 25px;
        margin-bottom: 35px;
        box-shadow: 0 12px 30px @shadowColor;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .andon-status-icon {
        font-size: 3.8rem;
        line-height: 1;
    }

    .andon-status-text {
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.5px;
    }

    /* Botón de acción Premium */
    .andon-submit-btn {
        width: 100%;
        background-color: #1a1a1a; /* Botón oscuro neutral */
        color: #ffffff;
        border: none;
        padding: 22px 30px;
        font-size: 1.25rem;
        font-weight: 600;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

        /* Efectos suaves en el botón */
        .andon-submit-btn:hover {
            background-color: #333333;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

        .andon-submit-btn:active {
            transform: translateY(0);
        }
</style>

<div class="andon-wrapper">

    <!-- NUEVO: Cápsula integrada de marca para el logo corporativo -->
    <div class="andon-brand-badge">
        <img src="~/image/toyoda-gosei-logo.png" alt="Toyoda Gosei" class="andon-brand-logo" />
    </div>

    <!-- Módulo de Control -->
    <div class="andon-main-panel">

        <!-- Nombre del Dispositivo / Estación -->
        <h1 class="andon-station-title">Andon 1</h1>

        <!-- Indicador Visual Interactivo -->
        <div class="andon-status-capsule">
            <div class="andon-status-icon">
                <i class="bi @iconClass"></i>
            </div>
            <h2 class="andon-status-text">@textEstado</h2>
        </div>

        <!-- Acción Principal -->
        <form asp-controller="Andon" asp-action="CambiarEstado" method="post">
            <button type="submit" class="andon-submit-btn">
                @if (Model.EstadoId == 1)
                {
                    <i class="bi bi-arrow-right-circle"></i>
                    <span>Resolver Incidencia</span>
                }
                else
                {
                    <i class="bi bi-play-circle"></i>
                    <span>Registrar Alerta</span>
                }
            </button>
        </form>

    </div>
</div>
